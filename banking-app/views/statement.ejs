<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Generate Statement</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .card {
      background: #ffffff;
      padding: 45px 40px;
      border-radius: 16px;
      width: 100%;
      max-width: 500px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.2);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 50px rgba(0,0,0,0.25);
    }

    .header {
      text-align: center;
      margin-bottom: 35px;
    }

    .icon-wrapper {
      width: 60px;
      height: 60px;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    .icon-wrapper i {
      font-size: 28px;
      color: white;
    }

    h2 {
      color: #1f2937;
      font-size: 28px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .subtitle {
      color: #6b7280;
      font-size: 15px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    label {
      display: block;
      color: #374151;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .input-icon {
      position: relative;
    }

    .input-icon i {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: #9ca3af;
      font-size: 16px;
    }

    .input-icon input {
      padding-left: 45px;
    }

    input {
      width: 100%;
      padding: 14px 16px;
      border: 2px solid #e5e7eb;
      border-radius: 8px;
      font-size: 15px;
      color: #1f2937;
      background: #f9fafb;
      transition: all 0.3s ease;
      font-family: inherit;
    }

    input:focus {
      outline: none;
      border-color: #6366f1;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    input::placeholder {
      color: #9ca3af;
    }

    button[type="submit"] {
      width: 100%;
      padding: 16px;
      border: none;
      border-radius: 10px;
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      color: white;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
      margin-top: 10px;
    }

    button[type="submit"]:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
      background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
    }

    button[type="submit"]:active {
      transform: translateY(0);
    }

    .error-message {
      background: #fee2e2;
      color: #991b1b;
      padding: 14px 20px;
      border-radius: 8px;
      margin-bottom: 20px;
      text-align: center;
      font-weight: 500;
      border-left: 4px solid #dc2626;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 20px;
      padding: 12px 24px;
      background: #f3f4f6;
      color: #6366f1;
      text-decoration: none;
      border-radius: 8px;
      transition: all 0.3s ease;
      font-weight: 600;
      width: 100%;
      font-size: 15px;
      justify-content: center;
    }

    .back-link:hover {
      background: #e5e7eb;
      gap: 12px;
    }

    .back-link i {
      font-size: 14px;
    }

    @media (max-width: 600px) {
      .card {
        padding: 35px 25px;
      }

      h2 {
        font-size: 24px;
      }

      input {
        font-size: 14px;
      }

      button[type="submit"] {
        font-size: 15px;
      }
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="header">
      <div class="icon-wrapper">
        <i class="fa fa-file-alt"></i>
      </div>
      <h2>Generate Statement</h2>
      <p class="subtitle">Enter account number to view transaction history</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message">
        <i class="fa fa-exclamation-circle"></i> <%= error %>
      </div>
    <% } %>

    <form action="/employee/statement" method="POST">
      <div class="form-group">
        <label>Account Number</label>
        <div class="input-icon">
          <i class="fa fa-user"></i>
          <input type="text" name="account_no" placeholder="Enter account number (e.g., NOVABANK001)" required>
        </div>
      </div>

      <button type="submit">
        <i class="fa fa-search"></i> Generate Statement
      </button>
    </form>

    <a href="/employee-dashboard" class="back-link">
      <i class="fa fa-arrow-left"></i> Back to Dashboard
    </a>
  </div>
</body>
</html>