<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NOVA Banking Dashboard</title>
   <!-- Boxicons -->

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    /* Deep navy color for sidebar + background */
    body {
      background-color: #0a1a2f; /* dark navy */
    }
    
    #sidebar {
      background-color: #0f2340; /* slightly lighter navy */
      min-height: 100vh; /* make it full height */
      padding: 1rem;
      width: 250px; /* fixed width for expanded state */
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
      transition: width 0.3s ease;
      overflow: hidden;
    }
    
    #sidebar.collapsed {
      width: 80px; /* collapsed width */
    }
    
    #sidebar .logo-section {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 0;
      margin-bottom: 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    
    #sidebar .logo {
      color: #4da6ff;
      font-weight: bold;
      font-size: 1.2rem;
      white-space: nowrap;
      opacity: 1;
      transition: opacity 0.3s ease;
    }
    
    #sidebar.collapsed .logo {
      opacity: 0;
    }
    
    #toggle-btn {
      background: none;
      border: none;
      padding: 4px;
      cursor: pointer;
      border-radius: 4px;
      transition: all 0.3s ease;
    }
    
    #toggle-btn:hover {
      background-color: rgba(255,255,255,0.1);
    }
    
    #toggle-btn img {
      width: 20px;
      height: 20px;
      transition: transform 0.3s ease;
    }
    
    #sidebar.collapsed #toggle-btn img {
      transform: rotate(180deg);
    }
    
    #sidebar ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    
    #sidebar li {
      margin-bottom: 0.5rem;
    }
    
    #sidebar a {
      color: #e3e3e3; /* light gray for links */
      text-decoration: none;
      display: flex;
      align-items: center;
      padding: 0.8rem 0.5rem;
      border-radius: 8px;
      transition: all 0.3s ease;
      position: relative;
    }
    
    #sidebar a:hover {
      color: #ffffff; /* brighter on hover */
      background-color: rgba(255,255,255,0.1);
    }
    
    #sidebar img {
      margin-right: 12px;
      width: 24px;
      height: 24px;
      opacity: 0.9;
      min-width: 24px; /* prevent shrinking */
    }
    
    #sidebar a:hover img {
      opacity: 1;
    }
    
    #sidebar .active a {
      color: #4da6ff;
      font-weight: bold;
      background-color: rgba(77, 166, 255, 0.1);
    }
    
    #sidebar .active img {
      opacity: 1;
    }
    
    #sidebar span {
      white-space: nowrap;
      opacity: 1;
      transition: opacity 0.3s ease;
    }
    
    #sidebar.collapsed span {
      opacity: 0;
    }
    
    /* Tooltip for collapsed state */
    #sidebar.collapsed a {
      position: relative;
    }
    
    #sidebar.collapsed a:hover::after {
      content: attr(data-tooltip);
      position: absolute;
      left: 70px;
      top: 50%;
      transform: translateY(-50%);
      background-color: #333;
      color: white;
      padding: 8px 12px;
      border-radius: 4px;
      font-size: 0.9rem;
      white-space: nowrap;
      z-index: 1001;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    
    /* Main content adjustment */
    main {
      margin-left: 250px;
      transition: margin-left 0.3s ease;
      padding: 1rem 2rem !important;
    }
    
    main.expanded {
      margin-left: 80px;
    }
    
    /* Navbar adjustment */
    .navbar {
      margin-left: 250px;
      transition: margin-left 0.3s ease;
      width: calc(100% - 250px);
      position: fixed;
      top: 0;
      z-index: 999;
    }
    
    .navbar.expanded {
      margin-left: 80px;
      width: calc(100% - 80px);
    }
    
    /* Add top margin to main content to account for fixed navbar */
    main {
      margin-top: 70px;
    }
  </style>
</head>
<body>

  <!-- ================= Navbar ================= -->
  <nav class="navbar navbar-expand-lg" style="background-color: #f8f9fa;">
    <div class="container-fluid">
      <!-- Bank Logo -->
      <a class="navbar-brand d-flex align-items-center" href="#">
        <img src="/public/NOVA BANK.png" alt="Logo" width="40" height="40" class="me-2">
        <span class="fw-bold text-primary">NOVA BANKING</span>
      </a>

      <!-- Search bar -->
      <form class="d-flex ms-auto me-3">
        <input class="form-control form-control-sm me-2" type="search" placeholder="Search accounts/transactions">
        <button class="btn btn-outline-primary btn-sm" type="submit">Search</button>
      </form>

      <!-- Profile & Notifications -->
      <div class="d-flex align-items-center">
        <button class="btn btn-light position-relative me-3">
          🔔
          <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
            3
          </span>
        </button>
        <div class="dropdown">
          <button class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
            👤 Profile
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="#">Settings</a></li>
            <li><a class="dropdown-item" href="/">Logout</a></li>
          </ul>
        </div>
      </div>
    </div>
  </nav>

  <!-- ================= Sidebar ================= -->
  <aside id="sidebar">
    <div class="logo-section">
      <span class="logo">Novabank</span>
      <button id="toggle-btn">
        <img src="/public/icons/double_arrow_24dp_F3F3F3_FILL0_wght400_GRAD0_opsz24.svg" alt="Toggle">
      </button>
    </div>
    
    <ul>
      <li class="active">
        <a href="dashboard.ejs" data-tooltip="Dashboard">
          <img src="/public/icons/dashboard.svg" height="24" width="24" alt="Dashboard">
          <span>Dashboard</span>
        </a>
      </li>
      <li>
        <a href="customer_accounts.ejs" data-tooltip="Customer Accounts">
          <img src="/public/icons/customer.svg" height="24" width="24" alt="Customer">
          <span>Customer Accounts</span>
        </a>
      </li>
      <li>
        <a href="transactions.ejs" data-tooltip="Transactions">
          <img src="/public/icons/transaction.svg" height="24" width="24" alt="Transaction">
          <span>Transactions</span>
        </a>
      </li>
      <li>
        <a href="loan_applications.ejs" data-tooltip="Loan Applications">
          <img src="/public/icons/loan.svg" height="24" width="24" alt="Loan">
          <span>Loan Applications</span>
        </a>
      </li>
      <li>
        <a href="KYC_verif.ejs" data-tooltip="KYC Verification">
          <img src="/public/icons/kyc.svg" height="24" width="24" alt="KYC">
          <span>KYC Verification</span>
        </a>
      </li>
      <li>
        <a href="reports.ejs" data-tooltip="Reports">
          <img src="/public/icons/report.svg" height="24" width="24" alt="Reports">
          <span>Reports</span>
        </a>    
      </li>
    </ul>
  </aside>

  <!-- ================= Main Content ================= -->
  <main>
    <!-- Welcome message -->
    <h4 class="mb-4 text-white">Good Morning, <span class="text-primary">Employee Name</span> 👋</h4>

    <div class="row g-3">
      <!-- Total Accounts -->
      <div class="col-md-4">
        <div class="card text-center shadow-sm">
          <div class="card-body">
            <h6 class="card-title text-muted">Total Accounts</h6>
            <h3 class="fw-bold">1523</h3>
            <a href="#" class="btn btn-sm btn-outline-primary mt-2">+ Open New Account</a>
          </div>
        </div>
      </div>

      <!-- Pending Approvals -->
      <div class="col-md-4">
        <div class="card text-center shadow-sm">
          <div class="card-body">
            <h6 class="card-title text-muted">Pending Approvals</h6>
            <h3 class="fw-bold">6</h3>
            <a href="#" class="btn btn-sm btn-outline-warning mt-2">Pending KYC Requests</a>
          </div>
        </div>
      </div>

      <!-- Flagged Transactions -->
      <div class="col-md-4">
        <div class="card text-center shadow-sm">
          <div class="card-body">
            <h6 class="card-title text-muted">Flagged Transactions</h6>
            <h3 class="fw-bold">3</h3>
            <a href="#" class="btn btn-sm btn-outline-danger mt-2">View Today's Flags</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mt-4">
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <h6 class="fw-bold">📊 Quick Stats</h6>
            <p class="text-muted">Placeholder for charts / graphs (future upgrade).</p>
          </div>
        </div>
      </div>

      <!-- Shortcuts -->
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <h6 class="fw-bold">⚡ Shortcuts</h6>
            <ul class="list-group list-group-flush">
              <li class="list-group-item"><a href="#">+ Open New Account</a></li>
              <li class="list-group-item"><a href="#">View All Transactions</a></li>
              <li class="list-group-item"><a href="#">Generate Reports</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    // Toggle sidebar functionality
    document.getElementById('toggle-btn').addEventListener('click', function() {
      const sidebar = document.getElementById('sidebar');
      const main = document.querySelector('main');
      const navbar = document.querySelector('.navbar');
      
      sidebar.classList.toggle('collapsed');
      main.classList.toggle('expanded');
      navbar.classList.toggle('expanded');
    });
  </script>
</body>
</html>